# MIMI Music Player - environment template
# Copy this file to .env.local and fill in your own values. NEVER commit real keys.
# Used by Next.js API routes (src/app/api/**) and the AI agent service.

# --- SenseNova / ModelScope-compatible AI gateway (optional) ---
# Base URL of the OpenAI-compatible endpoint used by /api/ai/* routes.
SENSENOVA_BASE_URL=
# Default model id shown in the AI settings panel.
SENSENOVA_DEFAULT_MODEL=
# Up to 5 keys are supported by src/store/aiStore.ts rotation (KEY_1..KEY_5).
SENSENOVA_API_KEY_1=
SENSENOVA_API_KEY_2=
SENSENOVA_API_KEY_3=
SENSENOVA_API_KEY_4=
SENSENOVA_API_KEY_5=
# Legacy single-key alias (some routes read this).
SENSENOVA_API_KEY=

# --- Next.js public runtime (optional) ---
# Public app URL; defaults to http://localhost:3025.
NEXT_PUBLIC_APP_URL=http://localhost:3025
# Python FastAPI backend URL (optional, used by AI capabilities).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# MediaPipe asset base; leave empty to use /mediapipe (generated by npm run sync:mediapipe).
NEXT_PUBLIC_MEDIAPIPE_ASSET_BASE=
