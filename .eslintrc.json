{
  "root": true,
  "ignorePatterns": ["archive/**", "scratch/**"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "react", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:prettier/recommended"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "no-whole-store": "error",
    "react/react-in-jsx-scope": "off",
    "prettier/prettier": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "react/prop-types": "off",
    "react/no-unknown-property": [
      "error",
      {
        "ignore": ["directory", "webkitdirectory", "jsx", "global"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/store/coordinator", "@/store/coordinator/*", "**/store/coordinator/*"],
            "message": "src/store/coordinator is a deprecated 0-import shell; use S6 domain use-cases instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/**/*.{ts,tsx}", "src/services/**/*.{ts,tsx}"],
      "excludedFiles": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/__tests__/**"],
      "rules": {
        "no-lib-service-getstate": "error"
      }
    }
  ]
}
