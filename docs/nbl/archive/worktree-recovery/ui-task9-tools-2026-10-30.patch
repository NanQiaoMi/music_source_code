+import { describe, expect, it } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+import { ToolStatusBanner, ToolSurface } from "./ToolSurface";
+
+describe("ToolSurface", () => {
+  it("renders a labelled professional tool region", () => {
+    const html = renderToStaticMarkup(
+      <ToolSurface title="Format converter" description="Prepare an export">
+        <p>Settings</p>
+      </ToolSurface>
+    );
+
+    expect(html).toContain('aria-label="Format converter"');
+    expect(html).toContain("Prepare an export");
+    expect(html).toContain("Settings");
+  });
+
+  it("announces errors and exposes an optional retry action", () => {
+    const html = renderToStaticMarkup(
+      <ToolStatusBanner status={{ kind: "error", label: "Export failed", retry: () => undefined }} />
+    );
+
+    expect(html).toContain('role="alert"');
+    expect(html).toContain("Export failed");
+    expect(html).toContain('aria-label="Retry"');
+  });
+});
