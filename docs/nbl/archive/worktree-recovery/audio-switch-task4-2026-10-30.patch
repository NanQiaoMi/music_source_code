+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { usePlaybackRuntimeStore } from "@/store/playbackRuntimeStore";
+import type { ResolvedAudioSource } from "./MultiSourceResolver";
+import { SourceSwitchCoordinator, type SourceSwitchPlayerPorts } from "./SourceSwitchCoordinator";
+
+const mixerMock = vi.hoisted(() => {
+  const generations = new WeakMap<object, number>();
+  let sequence = 0;
+  return {
+    prepareSilentDeck: vi.fn((audio: HTMLAudioElement) => {
+      const generation = ++sequence;
+      generations.set(audio, generation);
+      const muted = audio.muted;
+      audio.muted = true;
+      return {
+        audio,
+        generation,
+        isCurrent: () => generations.get(audio) === generation,
+        restoreOutput: (nextMuted = muted) => {
+          if (generations.get(audio) === generation) audio.muted = nextMuted;
+        },
+        cancel: () => {
+          if (generations.get(audio) === generation) {
+            audio.pause();
+            audio.muted = muted;
+          }
+        },
+      };
+    }),
+    transitionConfirmed: vi.fn(
+      (from: HTMLAudioElement, prepared: { restoreOutput: (muted?: boolean) => void }) => {
+        prepared.restoreOutput(from.muted);
+        from.pause();
+      }
+    ),
+  };
+});
+
+vi.mock("@/lib/audio/CrossfadeMixer", () => ({
+  CrossfadeMixer: { getInstance: () => mixerMock },
+}));
+
+class TestAudio extends EventTarget {
+  src = "";
+  currentSrc = "";
+  readyState = 0;
+  duration = Number.NaN;
+  paused = true;
+  seeking = false;
+  ended = false;
+  error: MediaError | null = null;
+  volume = 0.45;
+  muted = false;
+  playbackRate = 1;
+  defaultPlaybackRate = 1;
+  ranges: Array<[number, number]> = [];
+  private time = 0;
+  seekWrites: number[] = [];
+  autoSeek = false;
+  load = vi.fn(() => undefined);
+  play = vi.fn((): Promise<void> => {
+    this.paused = false;
+    return Promise.resolve();
+  });
+  pause = vi.fn(() => {
+    this.paused = true;
+    this.emit("pause");
+  });
+
+  get currentTime(): number {
+    return this.time;
+  }
+  set currentTime(value: number) {
+    this.time = value;
+    this.seekWrites.push(value);
+    this.seeking = true;
+    this.emit("seeking");
+    if (this.autoSeek) this.seeked();
+  }
+  get seekable(): TimeRanges {
+    return {
+      length: this.ranges.length,
+      start: (index) => this.ranges[index][0],
+      end: (index) => this.ranges[index][1],
+    };
+  }
+  advanceTo(value: number): void {
+    this.time = value;
+  }
+  emit(type: string): void {
+    this.dispatchEvent(new Event(type));
+  }
+  ready(duration = 180): void {
+    this.currentSrc = this.src;
+    this.readyState = 3;
+    this.duration = duration;
+    this.ranges = [[0, duration]];
+    this.emit("loadedmetadata");
+    this.emit("canplay");
+  }
+  seeked(): void {
+    this.seeking = false;
+    this.emit("seeked");
+  }
+  playing(): void {
+    this.paused = false;
+    this.emit("playing");
+  }
+  asElement(): HTMLAudioElement {
+    return this as unknown as HTMLAudioElement;
+  }
+}
+
+const candidate: ResolvedAudioSource = {
+  source: "qq",
+  url: "https://audio.example/b.flac?token=secret",
+  quality: "lossless",
+  format: "flac",
+  isTrial: false,
+};
+const options = { songId: "song-1", policyVersion: "captured-policy" };
+
+async function flush(): Promise<void> {
+  for (let index = 0; index < 12; index++) await Promise.resolve();
+}
+
+function setup(shouldPlay = true) {
+  const old = new TestAudio();
+  old.src = old.currentSrc = "https://audio.example/a.mp3";
+  old.readyState = 3;
+  old.duration = 180;
+  old.ranges = [[0, 180]];
+  old.advanceTo(42);
+  old.paused = !shouldPlay;
+  const target = new TestAudio();
+  let active = { id: "old-deck", audio: old.asElement() };
+  let standby = { id: "target-deck", audio: target.asElement() };
+  const runtime = usePlaybackRuntimeStore.getState();
+  const requestId = runtime.requestPlayback("song-1", old.src, shouldPlay);
+  runtime.bindActiveDeck(requestId, "song-1", active.id, old.src);
+  if (shouldPlay)
+    runtime.dispatchMediaEvent({ type: "playing", requestId, deckId: active.id, source: old.src });
+  const ports: SourceSwitchPlayerPorts = {
+    read: () => {
+      const state = usePlaybackRuntimeStore.getState();
+      return {
+        songId: state.targetSongId,
+        requestId: state.requestId,
+        shouldPlay: state.shouldPlay,
+        active,
+        standby,
+      };
+    },
+    toMediaSource: (url) => `/api/audio/proxy?url=${encodeURIComponent(url)}`,
+    prepareStandby: vi.fn(({ deck, source }) => {
+      deck.audio.src = source;
+      target.currentSrc = "";
+      target.readyState = 0;
+      target.duration = Number.NaN;
+      target.ranges = [];
+      deck.audio.load();
+    }),
+    handoff: vi.fn(({ to, from, requestId: committedRequestId }) => {
+      expect(usePlaybackRuntimeStore.getState().requestId).toBe(committedRequestId);
+      expect(usePlaybackRuntimeStore.getState().activeDeckId).toBe(to.id);
+      active = to;
+      standby = from;
+    }),
+    cleanupStandby: vi.fn(({ deck }) => {
+      deck.audio.src = "";
+    }),
+  };
+  const coordinator = new SourceSwitchCoordinator({ stageTimeoutMs: 1000, totalTimeoutMs: 5000 });
+  const unregister = coordinator.registerPlayer(ports);
+  const start = (next = candidate) => coordinator.switchTo(next, options);
+  const intent = (playing: boolean) => runtime.requestPlayback("song-1", old.src, playing);
+  const prepare = async (duration = 180) => {
+    target.ready(duration);
+    await flush();
+    target.seeked();
+    await flush();
+  };
+  return { coordinator, ports, old, target, requestId, start, intent, prepare, unregister };
+}
+
+describe("SourceSwitchCoordinator", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.clearAllMocks();
+    usePlaybackRuntimeStore.getState().reset();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+    usePlaybackRuntimeStore.getState().reset();
+  });
+
+  it("keeps old owner and audio until actual playing, then commits captured candidate", async () => {
+    const f = setup();
+    const phases: string[] = [];
+    const unsubscribe = usePlaybackRuntimeStore.subscribe((state) => {
+      if (state.sourceSwitchAttempt) phases.push(state.sourceSwitchAttempt.phase);
+    });
+    const result = f.start();
+    expect(usePlaybackRuntimeStore.getState().requestId).toBe(f.requestId);
+    expect(usePlaybackRuntimeStore.getState().activeDeckId).toBe("old-deck");
+    await f.prepare();
+    expect(f.target.muted).toBe(true);
+    expect(f.target.currentTime).toBe(42);
+    expect(f.old.pause).not.toHaveBeenCalled();
+    expect(f.ports.handoff).not.toHaveBeenCalled();
+    f.target.playing();
+    expect(await result).toMatchObject({
+      status: "committed",
+      requestId: f.requestId + 1,
+      adjustment: null,
+    });
+    expect(phases).toEqual(["preparing", "seeking", "confirming", "committing", "committed"]);
+    expect(usePlaybackRuntimeStore.getState().sessionSourceOverride?.audioUrl).toBe(candidate.url);
+    expect(usePlaybackRuntimeStore.getState().targetSource).toBe(f.old.currentSrc);
+    expect(f.target.volume).toBe(0.45);
+    expect(f.target.muted).toBe(false);
+    f.coordinator.cancelUncommitted();
+    expect(usePlaybackRuntimeStore.getState().sourceSwitchAttempt?.phase).toBe("committed");
+    unsubscribe();
+  });
+
+  it("does not accept a fulfilled play Promise without a valid playing event", async () => {
+    const f = setup();
+    const result = f.start();
+    await f.prepare();
+    await vi.advanceTimersByTimeAsync(1001);
+    expect(await result).toMatchObject({
+      status: "failed",
+      error: { phase: "confirming", code: "confirmation_timeout" },
+    });
+    expect(f.old.pause).not.toHaveBeenCalled();
+  });
+
+  it("commits a loaded and seeked paused target without ever calling play", async () => {
+    const f = setup(false);
+    const result = f.start();
+    await f.prepare();
+    expect(await result).toMatchObject({ status: "committed" });
+    expect(f.target.play).not.toHaveBeenCalled();
+    expect(f.target.paused).toBe(true);
+    expect(usePlaybackRuntimeStore.getState().phase).toBe("paused");
+  });
+
+  it("handles already available metadata and synchronous readiness/seeked/playing events", async () => {
+    const f = setup();
+    f.target.autoSeek = true;
+    f.ports.prepareStandby = ({ deck, source }) => {
+      deck.audio.src = source;
