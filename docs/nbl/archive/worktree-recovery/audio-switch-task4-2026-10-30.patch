+import { CrossfadeMixer } from "@/lib/audio/CrossfadeMixer";
+import type {
+  SourceSwitchIdentity,
+  SourceSwitchPendingPhase,
+  SourceSwitchStageError,
+} from "@/lib/audio/playbackStateMachine";
+import { usePlaybackRuntimeStore } from "@/store/playbackRuntimeStore";
+import type { ResolvedAudioSource } from "./MultiSourceResolver";
+
+export interface SourceSwitchDeck {
+  id: string;
+  audio: HTMLAudioElement;
+}
+
+export interface SourceSwitchPlayerSnapshot {
+  songId: string | null;
+  requestId: number;
+  shouldPlay: boolean;
+  active: SourceSwitchDeck | null;
+  standby: SourceSwitchDeck | null;
+}
+
+export interface SourceSwitchPreparation {
+  deck: SourceSwitchDeck;
+  source: string;
+  candidate: Readonly<ResolvedAudioSource>;
+  signal: AbortSignal;
+  isCurrent: () => boolean;
+}
+
+export interface SourceSwitchHandoff {
+  from: SourceSwitchDeck;
+  to: SourceSwitchDeck;
+  source: string;
+  candidate: Readonly<ResolvedAudioSource>;
+  songId: string;
+  requestId: number;
+  shouldPlay: boolean;
+  currentTime: number;
+}
+
+export interface SourceSwitchPlayerPorts {
+  read: () => SourceSwitchPlayerSnapshot;
+  toMediaSource: (url: string) => string;
+  /** Set/load only this standby. Check isCurrent after every asynchronous operation. */
+  prepareStandby: (input: SourceSwitchPreparation) => void | Promise<void>;
+  /** Synchronous ref/media-owner/clock transfer after the runtime has atomically committed. */
+  handoff: (input: SourceSwitchHandoff) => void;
+  cleanupStandby: (input: {
+    deck: SourceSwitchDeck;
+    source: string;
+    isCurrent: () => boolean;
+  }) => void;
+}
+
+export interface SourceSwitchTimeAdjustment {
+  reason: "shorter_duration";
+  fromTime: number;
+  toTime: number;
+  message: string;
+}
+
+export type SourceSwitchResult =
+  | {
+      status: "committed";
+      attemptId: number;
+      requestId: number;
+      adjustment: SourceSwitchTimeAdjustment | null;
+    }
+  | { status: "cancelled"; attemptId: number | null }
+  | { status: "failed"; attemptId: number | null; error: SourceSwitchStageError };
+
+export interface SourceSwitchOptions {
+  songId: string;
+  policyVersion: string;
+}
+
+export interface SourceSwitchCoordinatorOptions {
+  stageTimeoutMs?: number;
+  totalTimeoutMs?: number;
+}
+
+const SEEK_TOLERANCE_SECONDS = 0.15;
+const MAX_ALIGNMENTS = 5;
+const ERROR_MESSAGES: Record<string, string> = {
+  player_unavailable: "播放器尚未就绪，请稍后重试。",
+  invalid_candidate: "所选音源无效，请重新选择。",
+  prepare_failed: "目标音源加载失败，请重试或选择其他音源。",
+  metadata_timeout: "目标音源加载超时，已保留原音源。",
+  invalid_duration: "目标音源时长无效，无法安全切换。",
+  invalid_timeline: "当前播放位置不可用，无法安全切换。",
+  unseekable: "目标音源无法定位到当前进度，已保留原音源。",
+  seek_failed: "目标音源定位失败，已保留原音源。",
+  seek_timeout: "目标音源定位超时，已保留原音源。",
+  play_rejected: "目标音源未能开始播放，已保留原音源。",
+  confirmation_timeout: "目标音源播放确认超时，已保留原音源。",
+  media_load_error: "目标音源加载失败，已保留原音源。",
+  media_decode_error: "目标音源无法解码，已保留原音源。",
+  media_unsupported: "目标音源格式无法播放，已保留原音源。",
+  alignment_timeout: "目标音源无法同步最新进度，已保留原音源。",
+};
+
+class SwitchFailure extends Error {
+  constructor(readonly code: string) {
+    super(code);
+  }
+}
+class SwitchCancelled extends Error {}
+
+function sourceIdentity(source: string): string {
+  try {
+    return new URL(source, typeof window === "undefined" ? undefined : window.location.href).href;
+  } catch {
+    return source;
+  }
+}
+
+function stageError(phase: SourceSwitchPendingPhase, code: string): SourceSwitchStageError {
+  return { phase, code, message: ERROR_MESSAGES[code] ?? ERROR_MESSAGES.prepare_failed };
+}
+
+function isAligned(audio: HTMLAudioElement, time: number): boolean {
+  return (
+    Number.isFinite(audio.currentTime) &&
+    audio.currentTime >= 0 &&
+    (time === 0 || audio.currentTime > 0) &&
+    Math.abs(audio.currentTime - time) <= SEEK_TOLERANCE_SECONDS
+  );
+}
+
+export class SourceSwitchCoordinator {
+  private registration: { token: symbol; ports: SourceSwitchPlayerPorts } | null = null;
+  private pending: { identity: SourceSwitchIdentity; cancel: () => void } | null = null;
+  private elementGenerations = new WeakMap<HTMLAudioElement, number>();
+  private nextElementGeneration = 1;
+  private readonly stageTimeoutMs: number;
+  private readonly totalTimeoutMs: number;
+
+  constructor(options: SourceSwitchCoordinatorOptions = {}) {
+    this.stageTimeoutMs = options.stageTimeoutMs ?? 7000;
+    this.totalTimeoutMs = options.totalTimeoutMs ?? 20000;
+  }
+
+  registerPlayer(ports: SourceSwitchPlayerPorts): () => void {
+    this.cancelUncommitted();
+    const registration = { token: Symbol("source-switch-player"), ports };
+    this.registration = registration;
+    return () => {
+      if (this.registration !== registration) return;
+      this.cancelUncommitted();
+      this.registration = null;
+    };
+  }
+
+  cancelUncommitted(): void {
+    this.pending?.cancel();
+  }
+
+  async switchTo(
+    candidate: ResolvedAudioSource,
+    options: SourceSwitchOptions
+  ): Promise<SourceSwitchResult> {
+    this.cancelUncommitted();
+    const registration = this.registration;
+    const snapshot = registration?.ports.read();
+    const initial = usePlaybackRuntimeStore.getState();
+    if (
+      !registration ||
+      !snapshot?.active ||
+      !snapshot.standby ||
+      snapshot.active.audio === snapshot.standby.audio ||
+      snapshot.active.id === snapshot.standby.id ||
+      snapshot.songId !== options.songId ||
+      snapshot.requestId !== initial.requestId ||
+      initial.targetSongId !== options.songId ||
+      initial.activeDeckId !== snapshot.active.id
+    ) {
+      return {
+        status: "failed",
+        attemptId: null,
+        error: stageError("preparing", "player_unavailable"),
+      };
+    }
+    const selected = Object.freeze({ ...candidate });
+    let source: string;
+    try {
+      source = registration.ports.toMediaSource(selected.url);
+      if (!selected.url.trim() || !source.trim()) throw new SwitchFailure("invalid_candidate");
+    } catch {
+      return {
+        status: "failed",
+        attemptId: null,
+        error: stageError("preparing", "invalid_candidate"),
+      };
+    }
+    const { ports } = registration;
+    const from = snapshot.active;
+    const to = snapshot.standby;
+    const target = to.audio;
+    const previousSelectedSource = sourceIdentity(target.currentSrc);
+    const previousRequestedSource = sourceIdentity(target.src);
+    let freshLoad = previousRequestedSource === sourceIdentity(source) && target.readyState >= 2;
+    const attemptId = initial.beginSourceSwitch({
+      songId: options.songId,
+      expectedRequestId: initial.requestId,
+      policyVersion: options.policyVersion,
+      target: {
+        source: selected.source,
+        audioUrl: selected.url,
+        format: selected.format,
+        quality: selected.quality,
+        isTrial: selected.isTrial,
+        name: selected.name,
+      },
+      fromSource: initial.activeSource,
+    });
+    if (attemptId === null) return { status: "cancelled", attemptId: null };
+    const identity: SourceSwitchIdentity = {
+      attemptId,
+      songId: options.songId,
+      expectedRequestId: initial.requestId,
+      targetAudioUrl: selected.url,
+    };
+    const generation = this.nextElementGeneration++;
+    this.elementGenerations.set(target, generation);
+    const mixer = CrossfadeMixer.getInstance();
+    target.volume = from.audio.volume;
+    target.muted = from.audio.muted;
+    const prepared = mixer.prepareSilentDeck(target);
+    target.pause();
+    const abort = new AbortController();
+    const deadline = Date.now() + this.totalTimeoutMs;
+    let adjustment: SourceSwitchTimeAdjustment | null = null;
+    let committedRequestId: number | null = null;
+    let cleanupDone = false;
+
+    const phase = (): SourceSwitchPendingPhase => {
+      const current = usePlaybackRuntimeStore.getState().sourceSwitchAttempt;
+      return current?.attemptId === attemptId &&
+        ["preparing", "seeking", "confirming", "committing"].includes(current.phase)
+        ? (current.phase as SourceSwitchPendingPhase)
+        : "preparing";
+    };
+    const ownsTarget = () =>
+      this.elementGenerations.get(target) === generation && prepared.isCurrent();
+    const isCurrent = () => {
+      if (abort.signal.aborted || this.registration !== registration || !ownsTarget()) return false;
+      const state = usePlaybackRuntimeStore.getState();
+      const current = ports.read();
+      const attempt = state.sourceSwitchAttempt;
+      return (
+        attempt?.attemptId === attemptId &&
+        attempt.target.audioUrl === selected.url &&
+        ["preparing", "seeking", "confirming", "committing"].includes(attempt.phase) &&
+        state.requestId === identity.expectedRequestId &&
+        state.targetSongId === identity.songId &&
+        state.activeDeckId === from.id &&
+        state.activeSource === initial.activeSource &&
+        current.songId === identity.songId &&
+        current.requestId === identity.expectedRequestId &&
+        current.active?.audio === from.audio &&
+        current.standby?.audio === target
+      );
+    };
+    const assertCurrent = () => {
+      if (!isCurrent()) throw new SwitchCancelled();
+    };
+    const observeLoad = () => {
+      if (!isCurrent() || sourceIdentity(target.src) !== sourceIdentity(source)) return;
+      if (
+        target.readyState === 0 ||
+        !target.currentSrc ||
+        (target.readyState >= 1 && sourceIdentity(target.currentSrc) !== previousSelectedSource)
+      )
+        freshLoad = true;
+    };
+    const matchesSource = () => {
+      if (sourceIdentity(target.src) !== sourceIdentity(source) || !target.currentSrc) return false;
+      const currentSource = sourceIdentity(target.currentSrc);
+      if (currentSource === sourceIdentity(source)) return true;
+      // Redirect URLs are valid after this load starts. A changed request still selecting the known
+      // previous resource is stale, even when its native queued event arrives on this same element.
+      return (
+        freshLoad &&
+        !(
+          currentSource === previousSelectedSource &&
+          previousRequestedSource !== sourceIdentity(source)
+        )
+      );
+    };
+    const canCleanup = () =>
+      ownsTarget() &&
+      ports.read().active?.audio !== target &&
+      (!target.src || sourceIdentity(target.src) === sourceIdentity(source));
+    const cleanup = () => {
+      if (!canCleanup()) return;
+      prepared.cancel();
+      if (!cleanupDone) {
+        cleanupDone = true;
+        try {
+          ports.cleanupStandby({ deck: to, source, isCurrent: canCleanup });
+        } catch {
+          /* media cleanup is best effort */
+        }
+      }
+    };
+    const cancel = () => {
+      if (committedRequestId !== null || abort.signal.aborted) return;
+      abort.abort();
+      usePlaybackRuntimeStore.getState().cancelSourceSwitch(identity);
+      cleanup();
+    };
+    this.pending = { identity, cancel };
+    const unsubscribe = usePlaybackRuntimeStore.subscribe((state) => {
+      // The atomic commit notifies subscribers before commitSourceSwitch returns its new ID.
+      if (
+        state.sourceSwitchAttempt?.attemptId === attemptId &&
+        state.sourceSwitchAttempt.phase === "committed"
+      )
+        return;
+      if (!isCurrent()) cancel();
+    });
+    const setPhase = (next: "seeking" | "confirming" | "committing", targetSeekTime?: number) => {
+      assertCurrent();
+      const current = phase();
+      const effective =
+        current === "committing" || (current === "confirming" && next === "seeking")
+          ? current
+          : next;
+      usePlaybackRuntimeStore
+        .getState()
+        .updateSourceSwitchPhase({ ...identity, phase: effective, targetSeekTime });
+      // Repeated valid updates return false; validity comes from the identity, not that result.
+      assertCurrent();
+    };
+    const checkMediaError = () => {
+      if (
+        sourceIdentity(target.src) !== sourceIdentity(source) ||
+        (target.currentSrc && !matchesSource()) ||
+        !target.error
+      )
+        return;
+      const code =
+        target.error.code === 3
+          ? "media_decode_error"
+          : target.error.code === 4
+            ? "media_unsupported"
+            : "media_load_error";
+      throw new SwitchFailure(code);
+    };
+
+    const wait = (
+      check: (event?: Event) => boolean,
+      events: string[],
+      timeoutCode: string,
+      operate?: (notify: () => void) => void
+    ): Promise<void> =>
+      new Promise((resolve, reject) => {
+        let settled = false;
+        const finish = (error?: unknown) => {
+          if (settled) return;
+          settled = true;
+          clearTimeout(timer);
+          for (const event of [...events, "error"]) target.removeEventListener(event, onEvent);
+          abort.signal.removeEventListener("abort", onAbort);
+          stopRuntime?.();
+          if (error) reject(error);
+          else resolve();
+        };
+        const evaluate = (event?: Event) => {
+          if (settled) return;
+          try {
+            assertCurrent();
+            checkMediaError();
+            if (check(event)) finish();
+          } catch (error) {
+            finish(error);
+          }
+        };
+        const onEvent = (event: Event) => evaluate(event);
+        const onAbort = () => finish(new SwitchCancelled());
+        for (const event of [...events, "error"]) target.addEventListener(event, onEvent);
+        abort.signal.addEventListener("abort", onAbort, { once: true });
+        const stopRuntime = usePlaybackRuntimeStore.subscribe(() => evaluate());
+        const timer = setTimeout(
+          () => {
+            if (!isCurrent()) finish(new SwitchCancelled());
+            else finish(new SwitchFailure(timeoutCode));
+          },
+          Math.max(0, Math.min(this.stageTimeoutMs, deadline - Date.now()))
+        );
+        try {
+          operate?.(() => evaluate());
+        } catch (error) {
+          finish(error);
+        }
+        evaluate();
+      });
+
+    const loaded = () => {
+      checkMediaError();
+      if (!matchesSource() || target.readyState < 1) return false;
+      if (!Number.isFinite(target.duration) || target.duration <= 0)
+        throw new SwitchFailure("invalid_duration");
+      return target.readyState >= 2;
+    };
+    const desiredTime = (): number => {
+      const time = from.audio.currentTime;
+      if (
+        !Number.isFinite(time) ||
+        time < 0 ||
+        !Number.isFinite(from.audio.playbackRate) ||
+        from.audio.playbackRate <= 0
+      ) {
+        throw new SwitchFailure("invalid_timeline");
+      }
+      if (!loaded()) throw new SwitchFailure("seek_failed");
+      const desired = Math.min(time, target.duration - Math.min(0.05, target.duration / 2));
+      adjustment =
+        time >= target.duration
+          ? {
+              reason: "shorter_duration",
+              fromTime: time,
+              toTime: desired,
+              message: "所选版本较短，播放位置已调整到该版本末尾附近。",
+            }
+          : null;
+      return desired;
+    };
+    const assertSeekable = (desired: number) => {
+      for (let index = 0; index < target.seekable.length; index++) {
+        if (
+          Number.isFinite(target.seekable.start(index)) &&
+          Number.isFinite(target.seekable.end(index)) &&
+          target.seekable.start(index) <= desired &&
+          target.seekable.end(index) >= desired
+        )
+          return;
+      }
+      throw new SwitchFailure("unseekable");
+    };
+    const align = async () => {
+      assertCurrent();
+      const desired = desiredTime();
+      setPhase("seeking", desired);
+      assertSeekable(desired);
+      target.playbackRate = from.audio.playbackRate;
+      target.defaultPlaybackRate = from.audio.playbackRate;
+      if (!target.seeking && target.currentTime === desired) return;
+      let seeked = false;
+      await wait(
+        (event) => {
+          if (
+            event?.type === "seeked" &&
+            matchesSource() &&
+            !target.seeking &&
+            isAligned(target, desired)
+          )
+            seeked = true;
+          return seeked && loaded() && !target.seeking;
+        },
+        ["seeked", "canplay"],
+        "seek_timeout",
+        () => {
+          try {
+            target.currentTime = desired;
+          } catch {
+            throw new SwitchFailure("seek_failed");
+          }
+        }
+      );
+    };
+    let playingConfirmed = false;
+    let playSequence = 0;
+    const isPlaying = () => loaded() && !target.seeking && !target.paused && !target.ended;
+    const observePlaying = (event: Event) => {
+      if (!isCurrent()) return;
+      if (event.type !== "playing") playingConfirmed = false;
+      else if (
+        playSequence > 0 &&
+        matchesSource() &&
+        target.readyState >= 2 &&
+        !target.seeking &&
+        !target.paused &&
+        !target.ended &&
+        !target.error
+      )
+        playingConfirmed = true;
+    };
+    for (const event of ["playing", "pause", "waiting"])
+      target.addEventListener(event, observePlaying);
+    for (const event of ["loadstart", "emptied", "loadedmetadata"])
+      target.addEventListener(event, observeLoad);
+    const confirm = async () => {
+      for (let round = 0; round < MAX_ALIGNMENTS; round++) {
+        assertCurrent();
+        const shouldPlay = usePlaybackRuntimeStore.getState().shouldPlay;
+        if (!shouldPlay) {
+          playingConfirmed = false;
+          if (!target.paused) target.pause();
+          if (usePlaybackRuntimeStore.getState().shouldPlay) continue;
+          if (loaded() && !target.seeking && target.paused) return;
+        } else if (playingConfirmed && isPlaying()) return;
+        else {
+          let fulfilled = false;
+          let rejected = false;
+          const thisPlay = ++playSequence;
+          await wait(
+            (event) => {
+              if (!usePlaybackRuntimeStore.getState().shouldPlay) return true;
+              if (rejected) throw new SwitchFailure("play_rejected");
+              if (event?.type === "playing" && isPlaying()) playingConfirmed = true;
+              return fulfilled && playingConfirmed && isPlaying();
+            },
+            ["playing", "canplay", "pause"],
+            "confirmation_timeout",
+            (notify) => {
+              playingConfirmed = false;
+              let play: Promise<void>;
+              try {
+                play = target.play();
+              } catch {
+                throw new SwitchFailure("play_rejected");
+              }
+              play.then(
+                () => {
+                  if (!ownsTarget()) return;
+                  if (thisPlay === playSequence) fulfilled = true;
+                  const state = usePlaybackRuntimeStore.getState();
+                  if (!isCurrent() && committedRequestId === null) cleanup();
+                  else if (
+                    !state.shouldPlay &&
+                    sourceIdentity(target.src) === sourceIdentity(source)
+                  )
+                    target.pause();
+                  notify();
+                },
+                () => {
+                  if (!ownsTarget() || thisPlay !== playSequence) return;
+                  rejected = true;
+                  notify();
+                }
+              );
+            }
+          );
+        }
+      }
+      throw new SwitchFailure("confirmation_timeout");
+    };
+
+    try {
+      let preparationDone = false;
+      let preparationFailed = false;
+      await wait(
+        () => {
+          if (preparationFailed) throw new SwitchFailure("prepare_failed");
+          return preparationDone && loaded();
+        },
+        ["loadedmetadata", "loadeddata", "canplay", "durationchange", "progress"],
+        "metadata_timeout",
+        (notify) => {
+          let preparation: void | Promise<void>;
+          try {
+            preparation = ports.prepareStandby({
+              deck: to,
+              source,
+              candidate: selected,
+              signal: abort.signal,
+              isCurrent,
+            });
+          } catch {
+            throw new SwitchFailure("prepare_failed");
+          }
+          observeLoad();
+          Promise.resolve(preparation).then(
+            () => {
+              if (!isCurrent()) {
+                cleanup();
+                return;
+              }
+              preparationDone = true;
+              notify();
+            },
+            () => {
+              if (!isCurrent()) {
+                cleanup();
+                return;
+              }
+              preparationFailed = true;
+              notify();
+            }
+          );
+        }
+      );
+      for (let round = 0; round < MAX_ALIGNMENTS; round++) {
+        if (Date.now() >= deadline) throw new SwitchFailure("alignment_timeout");
+        await align();
+        setPhase("confirming");
+        await confirm();
+        assertCurrent();
+        const desired = desiredTime();
+        assertSeekable(desired);
+        if (
+          from.audio.seeking ||
+          target.playbackRate !== from.audio.playbackRate ||
+          !isAligned(target, desired)
+        ) {
+          playingConfirmed = false;
+          continue;
+        }
+        setPhase("committing", desired);
+        const latest = usePlaybackRuntimeStore.getState();
+        if (
+          latest.shouldPlay !== !target.paused ||
+          from.audio.seeking ||
+          (latest.shouldPlay && !playingConfirmed) ||
+          (latest.shouldPlay && !isPlaying()) ||
+          target.playbackRate !== from.audio.playbackRate ||
+          !isAligned(target, desiredTime())
+        )
+          continue;
+        target.volume = from.audio.volume;
+        const muted = from.audio.muted;
+        const confirmation = latest.shouldPlay
+          ? { kind: "playing" as const, deckId: to.id, source: sourceIdentity(source) }
+          : {
+              kind: "paused" as const,
+              deckId: to.id,
+              source: sourceIdentity(source),
+              loaded: true as const,
+              seeked: true as const,
+              paused: true as const,
+            };
+        committedRequestId = latest.commitSourceSwitch({ ...identity, confirmation });
+        if (committedRequestId === null) throw new SwitchCancelled();
+        const committed = usePlaybackRuntimeStore.getState();
+        if (
+          abort.signal.aborted ||
+          this.registration !== registration ||
+          !ownsTarget() ||
+          committed.requestId !== committedRequestId ||
+          committed.targetSongId !== identity.songId ||
+          committed.activeDeckId !== to.id ||
+          committed.activeSource !== sourceIdentity(source) ||
+          committed.sourceSwitchAttempt?.attemptId !== attemptId ||
+          committed.sourceSwitchAttempt.phase !== "committed"
+        ) {
+          committedRequestId = null;
+          throw new SwitchCancelled();
+        }
+        try {
+          ports.handoff({
+            from,
+            to,
+            source,
+            candidate: selected,
+            songId: identity.songId,
+            requestId: committedRequestId,
+            shouldPlay: latest.shouldPlay,
+            currentTime: target.currentTime,
+          });
+        } finally {
+          mixer.transitionConfirmed(from.audio, prepared, {
+            muted,
+            canCleanupFromAudio: () => ports.read().active?.audio !== from.audio,
+          });
+        }
+        return { status: "committed", attemptId, requestId: committedRequestId, adjustment };
+      }
+      throw new SwitchFailure("alignment_timeout");
+    } catch (error) {
+      if (committedRequestId !== null) {
+        // Output/cleanup failure cannot undo the runtime's successful ownership transfer.
+        prepared.restoreOutput(from.audio.muted);
+        return { status: "committed", attemptId, requestId: committedRequestId, adjustment };
+      }
+      if (error instanceof SwitchCancelled || !isCurrent()) {
+        cancel();
+        return { status: "cancelled", attemptId };
+      }
+      const failure = stageError(
+        phase(),
+        error instanceof SwitchFailure ? error.code : "prepare_failed"
+      );
+      usePlaybackRuntimeStore.getState().failSourceSwitch({ ...identity, error: failure });
+      abort.abort();
+      cleanup();
+      return { status: "failed", attemptId, error: failure };
+    } finally {
+      for (const event of ["playing", "pause", "waiting"])
+        target.removeEventListener(event, observePlaying);
+      for (const event of ["loadstart", "emptied", "loadedmetadata"])
+        target.removeEventListener(event, observeLoad);
+      unsubscribe();
+      if (this.pending?.identity.attemptId === attemptId) this.pending = null;
+    }
+  }
+}
+
+export const sourceSwitchCoordinator = new SourceSwitchCoordinator();
