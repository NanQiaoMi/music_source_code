+  const groups: LyricLineGroup[] = [];
+  for (const { line } of sorted) {
+    let group = groups[groups.length - 1];
+    if (!group || group.start !== line.start) {
+      group = { start: line.start, lines: [] };
+      groups.push(group);
+    }
