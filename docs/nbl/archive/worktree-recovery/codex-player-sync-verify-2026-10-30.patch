+vi.mock("./AudioEngine", () => ({
+  AudioEngine: { getInstance: () => audioEngineMock.engine },
+}));
+
+import { CrossfadeMixer } from "./CrossfadeMixer";
+
+function createAudioElement(): HTMLAudioElement {
+  return {
+    paused: false,
+    currentTime: 24,
+    volume: 1,
+    play: vi.fn().mockResolvedValue(undefined),
+    pause: vi.fn(),
+  } as unknown as HTMLAudioElement;
