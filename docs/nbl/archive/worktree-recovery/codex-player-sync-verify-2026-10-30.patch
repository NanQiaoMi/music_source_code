+
+function segmentGraphemes(text: string): string[] {
+  if (typeof Intl !== "undefined") {
+    const Segmenter = (
+      Intl as unknown as {
+        Segmenter?: new (
+          locales?: string | string[],
+          options?: { granularity: "grapheme" }
+        ) => { segment: (input: string) => Iterable<{ segment: string }> };
+      }
+    ).Segmenter;
