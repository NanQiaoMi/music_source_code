+
+function isRegionalIndicatorCodePoint(codePoint: string | undefined): boolean {
+  if (!codePoint) return false;
+  const value = codePoint.codePointAt(0) ?? 0;
+  return value >= 0x1f1e6 && value <= 0x1f1ff;
