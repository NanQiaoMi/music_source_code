+  const context = {
+    currentTime: 10,
+    createGain: vi.fn(() => {
+      const node = {
+        gain: {
+          value: 1,
+          cancelScheduledValues: vi.fn(),
+          setValueAtTime: vi.fn(),
+          linearRampToValueAtTime: vi.fn(),
+        },
+        connect: vi.fn(),
+      };
+      gainNodes.push(node);
+      return node;
+    }),
