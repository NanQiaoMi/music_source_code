+import { describe, expect, it, vi } from "vitest";
+import { handleVisualizationDoubleClick } from "./VisualizationView";
+
+describe("VisualizationView double-click routing", () => {
+  it("keeps marked settings and control surfaces from toggling fullscreen", () => {
+    const chrome = document.createElement("aside");
+    chrome.dataset.foliaMvChrome = "";
+    const control = document.createElement("button");
+    chrome.appendChild(control);
+    const stopPropagation = vi.fn();
+    const toggleFullscreen = vi.fn();
+
+    handleVisualizationDoubleClick({ target: control, stopPropagation }, toggleFullscreen);
+
+    expect(stopPropagation).toHaveBeenCalledOnce();
+    expect(toggleFullscreen).not.toHaveBeenCalled();
+  });
+
+  it("keeps fullscreen double-clicks on the unmarked stage", () => {
+    const stage = document.createElement("div");
+    const stopPropagation = vi.fn();
+    const toggleFullscreen = vi.fn();
+
+    handleVisualizationDoubleClick({ target: stage, stopPropagation }, toggleFullscreen);
+
+    expect(stopPropagation).toHaveBeenCalledOnce();
+    expect(toggleFullscreen).toHaveBeenCalledOnce();
+  });
+});
