+import { describe, expect, it, vi } from "vitest";
+import { normalizeFoliaMvSettings, resolveFoliaMvPalette } from "./program";
+import { createFoliaMvLightField, sampleFoliaMvSceneLight } from "./lightField";
+import { buildFoliaMvSceneModel } from "./sceneModel";
+import type { FoliaMvFrame, FoliaMvPixi, FoliaMvShot } from "./types";
+
+class FakeTransform {
+  x = 0;
+  y = 0;
+
+  set(x: number, y = x): void {
+    this.x = x;
+    this.y = y;
+  }
+}
+
+class FakeContainer {
+  children: FakeContainer[] = [];
+  label = "";
+  alpha = 1;
+  rotation = 0;
+  blendMode = "normal";
+  position = new FakeTransform();
+  scale = new FakeTransform();
+  filters: unknown = null;
+
+  addChild(...children: FakeContainer[]): FakeContainer[] {
+    this.children.push(...children);
+    return children;
+  }
+
+  destroy(options?: { children?: boolean }): void {
+    if (options?.children) this.children.forEach((child) => child.destroy(options));
+    this.children = [];
+  }
+}
+
+class FakeGraphics extends FakeContainer {
+  fillCalls: unknown[] = [];
+
+  clear(): this {
+    return this;
+  }
+
+  rect(): this {
+    return this;
+  }
+
+  fill(options?: unknown): this {
+    this.fillCalls.push(options);
+    return this;
+  }
+}
+
+class FakeGradient {
+  destroyed = false;
+
+  constructor(readonly options: unknown) {}
+
+  destroy(): void {
+    this.destroyed = true;
+  }
+}
+
+class FakeSprite extends FakeContainer {
+  constructor(_texture: unknown) {
+    super();
+  }
+}
+
+const shot: FoliaMvShot = {
+  id: "shader-shot",
+  seed: 44,
+  start: 0,
+  end: 8,
+  lineIndices: [],
+  kind: "instrumental",
+  profile: "window",
+  composition: "staircase",
+};
+
+function makeFrame(overrides: Partial<FoliaMvFrame> = {}): FoliaMvFrame {
+  const settings = normalizeFoliaMvSettings(undefined);
+  return {
+    musicTime: 4,
+    ambientTime: 1,
+    width: 1280,
+    height: 720,
+    reducedMotion: false,
+    bass: 0.1,
+    mid: 0.2,
+    treble: 0.1,
+    settings,
+    palette: resolveFoliaMvPalette(settings),
+    shot,
+    ...overrides,
+  };
+}
+
+function makePixi() {
+  type FakeUniform = { value: number | Float32Array; type: string };
+  interface FakeFilterOptions {
+    gl: { vertex: string; fragment: string };
+    resolution: number;
+    resources: { foliaLight: Record<string, FakeUniform> };
+  }
+  const filters: Array<{
+    options: FakeFilterOptions;
+    resources: { foliaLight: { uniforms: Record<string, number | Float32Array> } };
+    resolution: number;
+    destroy: ReturnType<typeof vi.fn>;
+  }> = [];
+  const pixi = {
+    Container: FakeContainer,
+    Graphics: FakeGraphics,
+    FillGradient: FakeGradient,
+    Sprite: FakeSprite,
+    Texture: { WHITE: {} },
+    defaultFilterVert: "default filter vertex",
+    Filter: {
+      from: (rawOptions: unknown) => {
+        const options = rawOptions as FakeFilterOptions;
+        const group = options.resources.foliaLight;
+        const uniforms = Object.fromEntries(
+          Object.entries(group).map(([name, uniform]) => [name, uniform.value])
+        );
+        const filter = {
+          options,
+          resources: { foliaLight: { uniforms } },
+          resolution: 1,
+          padding: 0,
+          blendMode: "normal",
+          destroy: vi.fn(),
+        };
+        filters.push(filter);
+        return filter;
+      },
+    },
+  } as unknown as FoliaMvPixi;
+  return { pixi, filters };
+}
+
+function getOnlyFilter(filters: ReturnType<typeof makePixi>["filters"]) {
+  expect(filters).toHaveLength(1);
+  return filters[0]!;
+}
+
+function layerByLabel(field: ReturnType<typeof createFoliaMvLightField>, label: string) {
+  const layer = field.view.children.find((child) => child.label === label);
+  expect(layer).toBeDefined();
+  return layer as unknown as FakeGraphics;
+}
+
+function firstGradient(layer: FakeGraphics): FakeGradient {
+  const gradient = layer.fillCalls[0];
+  expect(gradient).toBeInstanceOf(FakeGradient);
+  return gradient as FakeGradient;
+}
+
+function parseRgba(value: string): [number, number, number, number] {
+  const match = /^rgba\((\d+),\s*(\d+),\s*(\d+),\s*([\d.]+)\)$/u.exec(value);
+  expect(match).not.toBeNull();
+  return [Number(match?.[1]), Number(match?.[2]), Number(match?.[3]), Number(match?.[4])];
+}
+
+describe("createFoliaMvLightField", () => {
+  it("keeps the field localized and separates warm and blue light colors", () => {
+    const { pixi } = makePixi();
+    const field = createFoliaMvLightField(pixi);
+    const input = makeFrame();
+    field.resize(input.width, input.height);
+    field.update(input);
+
+    const haze = layerByLabel(field, "Folia MV atmosphere haze");
+    const cool = layerByLabel(field, "Folia MV cool glow");
+    const warm = layerByLabel(field, "Folia MV warm glow");
+    const warmBeam = layerByLabel(field, "Folia MV warm beam");
+    const coolBeam = layerByLabel(field, "Folia MV cool beam");
+    const coolColor = parseRgba(
+      (firstGradient(cool).options as { colorStops: Array<{ color: string }> }).colorStops[0]!.color
+    );
+    const warmColor = parseRgba(
+      (firstGradient(warm).options as { colorStops: Array<{ color: string }> }).colorStops[0]!.color
+    );
+    const coolBeamColor = parseRgba(
+      (firstGradient(coolBeam).options as { colorStops: Array<{ color: string }> }).colorStops[2]!
+        .color
+    );
+    const warmBeamColor = parseRgba(
+      (firstGradient(warmBeam).options as { colorStops: Array<{ color: string }> }).colorStops[2]!
+        .color
+    );
+
+    expect(coolColor[2]).toBeGreaterThan(coolColor[0] * 1.6);
+    expect(warmColor[0]).toBeGreaterThan(warmColor[2] * 1.5);
+    expect(coolBeamColor[2]).toBeGreaterThan(coolBeamColor[0] * 1.6);
+    expect(warmBeamColor[0]).toBeGreaterThan(warmBeamColor[2] * 1.5);
+    expect(haze.alpha).toBeLessThanOrEqual(0.2);
+    expect(cool.alpha).toBeLessThanOrEqual(0.36);
+    expect(warm.alpha).toBeLessThanOrEqual(0.45);
+    expect(warmBeam.alpha).toBeLessThanOrEqual(0.38);
+    expect(coolBeam.alpha).toBeLessThanOrEqual(0.3);
+    expect(warm.scale.x).toBeLessThanOrEqual(input.width * 0.55);
+    expect(cool.scale.x).toBeLessThanOrEqual(input.width * 0.46);
+    expect(warmBeam.scale.x).toBeLessThanOrEqual(input.width * 0.12);
+    expect(coolBeam.scale.x).toBeLessThanOrEqual(input.width * 0.1);
+    const initialWarmBeamWidth = warmBeam.scale.x;
+    const initialCoolBeamWidth = coolBeam.scale.x;
+    field.resize(input.width / 2, input.height / 2);
+    expect(warmBeam.scale.x).toBeCloseTo(initialWarmBeamWidth / 2);
+    expect(coolBeam.scale.x).toBeCloseTo(initialCoolBeamWidth / 2);
+
+    field.destroy();
+  });
+
+  it("keeps lyric illumination local instead of lifting the full frame", () => {
+    const input = makeFrame();
+    const model = buildFoliaMvSceneModel(input);
+    const focus = sampleFoliaMvSceneLight(
+      model.focusX * input.width,
+      model.focusY * input.height,
+      input
+    );
+    const farCorner = sampleFoliaMvSceneLight(input.width, input.height, input);
+
+    expect(focus).toBeGreaterThan(0.35);
+    expect(farCorner).toBeLessThanOrEqual(0.05);
+  });
+
+  it("freezes sampled light modulation under reduced motion", () => {
+    const firstFrame = makeFrame({ reducedMotion: true, musicTime: 2 });
+    const model = buildFoliaMvSceneModel(firstFrame);
+    const x = model.focusX * firstFrame.width;
+    const y = model.focusY * firstFrame.height;
+    const first = sampleFoliaMvSceneLight(x, y, firstFrame);
+    const later = sampleFoliaMvSceneLight(x, y, {
+      ...firstFrame,
+      musicTime: 8,
+      ambientTime: 40,
+    });
+
+    expect(later).toBe(first);
+  });
+
+  it("releases each staged gradient and shader when the field is destroyed", () => {
+    const { pixi, filters } = makePixi();
+    const field = createFoliaMvLightField(pixi);
+    const input = makeFrame();
+    field.update(input);
+    const gradients = field.view.children.flatMap((child) =>
+      child instanceof FakeGraphics
+        ? child.fillCalls.filter((value): value is FakeGradient => value instanceof FakeGradient)
+        : []
+    );
+    const shader = getOnlyFilter(filters);
+
+    field.destroy();
+
+    expect(gradients.length).toBeGreaterThanOrEqual(5);
+    expect(gradients.every((gradient) => gradient.destroyed)).toBe(true);
+    expect(shader.destroy).toHaveBeenCalledOnce();
+  });
+
+  it("uses a half-resolution low-frequency shader and wires light, grain and feather uniforms", () => {
+    const { pixi, filters } = makePixi();
+    const field = createFoliaMvLightField(pixi);
+    const settings = { ...normalizeFoliaMvSettings(undefined), filmGrain: 0.6, shimmerFeather: 80 };
+    const input = makeFrame({ settings, ambientTime: 2 });
+    field.resize(input.width, input.height);
+    field.update(input);
+
+    const shader = getOnlyFilter(filters);
+    const uniforms = shader.resources.foliaLight.uniforms;
+    const beam = field.view.children[3]!;
+    const model = buildFoliaMvSceneModel(input);
+
+    expect(shader.options.gl.fragment).toContain("slowCloud");
+    expect(shader.options.gl.fragment).toContain("uGrain");
+    expect(shader.options.resolution).toBe(0.5);
+    expect(shader.resolution).toBe(0.5);
+    expect((uniforms.uFocus as Float32Array)[0]).toBeCloseTo(model.focusX + model.parallaxX);
+    expect((uniforms.uFocus as Float32Array)[1]).toBeCloseTo(model.focusY + model.parallaxY);
+    expect(uniforms.uGrain).toBe(0.6);
+    expect(uniforms.uFeather).toBe(0.8);
+    expect(uniforms.uBreath).not.toBe(0);
+    expect(beam.scale.x).toBeGreaterThan(1280 * 0.055);
+    field.destroy();
+    expect(shader.destroy).toHaveBeenCalledOnce();
+  });
+
+  it("keeps shader placement stable at equal music time while ambient breathing remains subtle", () => {
+    const { pixi, filters } = makePixi();
+    const field = createFoliaMvLightField(pixi);
+    field.update(makeFrame({ ambientTime: 1 }));
+    const shader = getOnlyFilter(filters);
+    const uniforms = shader.resources.foliaLight.uniforms;
+    const focusAtFirstAmbient = Array.from(uniforms.uFocus as Float32Array);
+    const breathAtFirstAmbient = uniforms.uBreath as number;
+    field.update(makeFrame({ ambientTime: 29 }));
+
+    expect(Array.from(uniforms.uFocus as Float32Array)).toEqual(focusAtFirstAmbient);
+    expect(uniforms.uBreath).not.toBe(breathAtFirstAmbient);
+    expect(Math.abs(uniforms.uBreath as number)).toBeLessThanOrEqual(0.009);
+    field.destroy();
+  });
+
+  it("freezes shader cloud and grain animation under reduced motion", () => {
+    const { pixi, filters } = makePixi();
+    const field = createFoliaMvLightField(pixi);
+    const settings = { ...normalizeFoliaMvSettings(undefined), filmGrain: 0.55 };
+    field.update(makeFrame({ musicTime: 4, ambientTime: 1, reducedMotion: true, settings }));
+    const uniforms = getOnlyFilter(filters).resources.foliaLight.uniforms;
+    const reducedMotionInputs = {
+      time: uniforms.uTime,
+      breath: uniforms.uBreath,
+      grain: uniforms.uGrain,
+    };
+
+    field.update(makeFrame({ musicTime: 11, ambientTime: 32, reducedMotion: true, settings }));
+
+    expect(uniforms.uTime).toBe(reducedMotionInputs.time);
+    expect(uniforms.uBreath).toBe(reducedMotionInputs.breath);
+    expect(uniforms.uGrain).toBe(reducedMotionInputs.grain);
+    expect(uniforms.uGrain).toBe(0.55);
+
+    field.update(makeFrame({ musicTime: 4, ambientTime: 1, reducedMotion: false, settings }));
+    const motionTime = uniforms.uTime;
+    const motionBreath = uniforms.uBreath;
+    field.update(makeFrame({ musicTime: 11, ambientTime: 32, reducedMotion: false, settings }));
+
+    expect(uniforms.uTime).not.toBe(motionTime);
+    expect(uniforms.uBreath).not.toBe(motionBreath);
+    field.destroy();
+  });
+
+  it("widens the visible beam when shimmer feather increases", () => {
+    const { pixi } = makePixi();
+    const field = createFoliaMvLightField(pixi);
+    const settings = normalizeFoliaMvSettings(undefined);
+    field.resize(1000, 600);
+    field.update(
+      makeFrame({ width: 1000, height: 600, settings: { ...settings, shimmerFeather: 0 } })
+    );
+    const narrow = field.view.children[3]!.scale.x;
+    field.update(
+      makeFrame({ width: 1000, height: 600, settings: { ...settings, shimmerFeather: 100 } })
+    );
+    const wide = field.view.children[3]!.scale.x;
+
+    expect(wide).toBeGreaterThan(narrow);
+    field.destroy();
+  });
+});
