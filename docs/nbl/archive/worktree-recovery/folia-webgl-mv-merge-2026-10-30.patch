+describe("FoliaLyricMv host fallback integration", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  let rafCallbacks: Map<number, FrameRequestCallback>;
+  let nextFrameId: number;
+
+  const drawOneFrame = async () => {
+    const next = rafCallbacks.entries().next().value as [number, FrameRequestCallback] | undefined;
+    if (!next) return;
+    rafCallbacks.delete(next[0]);
+    await act(async () => next[1](1000));
+  };
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    rafCallbacks = new Map();
+    nextFrameId = 0;
+    requestedCanvases = [];
