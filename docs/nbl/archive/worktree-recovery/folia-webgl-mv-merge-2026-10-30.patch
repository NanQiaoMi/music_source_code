+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const hostHarness = vi.hoisted(() => ({
+  ui: {} as Record<string, unknown>,
+  audio: {} as Record<string, unknown>,
+  visualization: {} as Record<string, unknown>,
+  visualSettings: {} as Record<string, unknown>,
+  draws: [] as HTMLCanvasElement[],
+  captureStreams: [] as Array<{ canvas: HTMLCanvasElement; track: { readyState: string } }>,
+  activeCapture: null as { canvas: HTMLCanvasElement; track: { readyState: string } } | null,
+  contexts: new Map<HTMLCanvasElement, Record<string, unknown>>(),
+  frameCallbacks: new Map<number, FrameRequestCallback>(),
+  nextFrameId: 1,
+}));
+
+vi.mock("next/dynamic", async () => {
+  const ReactModule = await vi.importActual<typeof import("react")>("react");
+
+  function RecordingPanelStub({
+    isOpen,
+    canvasRef,
+  }: {
+    isOpen: boolean;
+    canvasRef: React.RefObject<HTMLCanvasElement | null>;
+  }) {
+    ReactModule.useEffect(() => {
+      if (!isOpen || !canvasRef.current || hostHarness.activeCapture) return;
+      const canvas = canvasRef.current;
+      canvas.captureStream(30);
+    }, [canvasRef, isOpen]);
+    return null;
+  }
+
+  function FoliaStageStub({
+    captureCanvasRef,
+    onOpenRecording,
+  }: {
+    captureCanvasRef: React.RefObject<HTMLCanvasElement | null>;
+    onOpenRecording: () => void;
+  }) {
+    ReactModule.useEffect(() => {
+      const canvas = captureCanvasRef.current;
+      if (!canvas) return;
+      const context = canvas.getContext("2d");
+      context?.fillRect(0, 0, 12, 12);
+    }, [captureCanvasRef]);
+
+    return ReactModule.createElement(
+      "button",
+      { "data-testid": "open-recording", onClick: onOpenRecording },
+      "Record"
+    );
+  }
+
+  const components = [RecordingPanelStub, () => null, () => null, FoliaStageStub];
+  let componentIndex = 0;
+  return { default: () => components[componentIndex++] };
+});
+
+vi.mock("framer-motion", async () => {
+  const ReactModule = await vi.importActual<typeof import("react")>("react");
+  const passthrough = ({
+    children,
+    className,
+    style,
+    onDoubleClick,
+  }: React.HTMLAttributes<HTMLElement>) =>
+    ReactModule.createElement("div", { className, style, onDoubleClick }, children);
+  return { motion: new Proxy({}, { get: () => passthrough }), AnimatePresence: passthrough };
+});
+
+vi.mock("@/store/uiStore", () => {
+  const hook = Object.assign(
+    (selector?: (state: Record<string, unknown>) => unknown) =>
+      selector ? selector(hostHarness.ui) : hostHarness.ui,
+    {
+      getState: () => hostHarness.ui,
+      setState: (patch: Record<string, unknown>) => Object.assign(hostHarness.ui, patch),
+    }
+  );
+  return { useUIStore: hook };
+});
+
+vi.mock("@/store/audioStore", () => {
+  const hook = Object.assign(
+    (selector?: (state: Record<string, unknown>) => unknown) =>
+      selector ? selector(hostHarness.audio) : hostHarness.audio,
+    {
+      getState: () => hostHarness.audio,
+      setState: (patch: Record<string, unknown>) => Object.assign(hostHarness.audio, patch),
+    }
+  );
+  return { useAudioStore: hook };
+});
+
+vi.mock("@/store/visualizationStore", () => {
+  const hook = Object.assign(
+    (selector?: (state: Record<string, unknown>) => unknown) =>
+      selector ? selector(hostHarness.visualization) : hostHarness.visualization,
+    {
+      getState: () => hostHarness.visualization,
+      setState: (patch: Record<string, unknown>) => Object.assign(hostHarness.visualization, patch),
+    }
+  );
+  return { useVisualizationStore: hook };
+});
+
+vi.mock("@/store/visualSettingsStore", () => ({
+  useVisualSettingsStore: () => hostHarness.visualSettings,
+}));
+
+vi.mock("@/store/statsAchievementsStore", () => ({
+  useStatsAchievementsStore: {
+    getState: () => ({ reportProToolsUsage: vi.fn() }),
+  },
+}));
+
+vi.mock("@/hooks/useAudioPlayer", () => ({
+  getAudioAnalyser: () => null,
+  useAudioPlayer: () => ({ audioRef: { current: null }, seek: vi.fn() }),
+}));
+
+vi.mock("./effects", () => ({
+  drawCinematicOrientalInk: vi.fn(),
+  drawSpatialMesh: vi.fn(),
+  drawCyberpunkParticles: vi.fn(),
+  drawOrganicFluid: vi.fn(),
+  drawAuroraWave: vi.fn(),
+  drawSpectrumRing: vi.fn(),
+  drawNebulaField: vi.fn(),
+  drawVinylGroove: vi.fn(),
+  drawCyberMatrix: vi.fn(),
+  drawGravitationalField: vi.fn(),
+  drawPrismPulse: vi.fn(),
+  drawCinematicSilkAurora: vi.fn(),
+  drawOrientalLandscape: vi.fn(),
+  drawCinematicLyricDrift: vi.fn(),
+}));
+
+import { VisualizationView } from "./VisualizationView";
+
+describe("VisualizationView capture continuity across Folia effect switches", () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  let originalGetContext: typeof HTMLCanvasElement.prototype.getContext;
+  let originalCaptureStream: PropertyDescriptor | undefined;
+  let originalVisibilityState: PropertyDescriptor | undefined;
+
+  beforeEach(() => {
+    hostHarness.ui = {
+      currentView: "visualization",
+      setCurrentView: vi.fn(),
+      isTransitioning: false,
+      themeColors: null,
+      isDynamicTheme: false,
+      isFullscreen: false,
+      toggleFullscreen: vi.fn(),
+    };
+    hostHarness.audio = {
+      currentSong: null,
+      isPlaying: false,
+      currentTime: 0,
+      duration: 30,
+      playbackRate: 1,
+      bufferedRanges: [],
+      prevSong: vi.fn(),
+      nextSong: vi.fn(),
+      setCurrentTime: vi.fn(),
+      setDuration: vi.fn(),
+      togglePlaybackIntent: vi.fn(),
+    };
+    hostHarness.visualization = {
+      currentEffect: "cinematicLyricDrift",
+      setCurrentEffect: vi.fn((effect: string) => {
+        hostHarness.visualization.currentEffect = effect;
+      }),
+      effectSettings: {
+        cinematicLyricDrift: {},
+        cinematicOrientalInk: {},
+        spatialMesh: { blurIntensity: 0 },
+      },
+    };
+    hostHarness.visualSettings = { currentTheme: "dark" };
+    hostHarness.draws = [];
+    hostHarness.captureStreams = [];
+    hostHarness.activeCapture = null;
+    hostHarness.contexts = new Map();
+    hostHarness.frameCallbacks = new Map();
+    hostHarness.nextFrameId = 1;
+
+    originalGetContext = HTMLCanvasElement.prototype.getContext;
+    vi.spyOn(HTMLCanvasElement.prototype, "getContext").mockImplementation(function (
+      this: HTMLCanvasElement,
+      type: string
+    ) {
+      if (type !== "2d") return null;
+      let context = hostHarness.contexts.get(this);
+      if (!context) {
+        context = {
+          fillRect: () => hostHarness.draws.push(this),
+          clearRect: () => undefined,
+          setTransform: () => undefined,
+          setLineDash: () => undefined,
+          drawImage: () => hostHarness.draws.push(this),
+          save: () => undefined,
+          restore: () => undefined,
+        };
+        hostHarness.contexts.set(this, context);
+      }
+      return context;
+    } as typeof HTMLCanvasElement.prototype.getContext);
+
+    originalCaptureStream = Object.getOwnPropertyDescriptor(
+      HTMLCanvasElement.prototype,
+      "captureStream"
+    );
+    Object.defineProperty(HTMLCanvasElement.prototype, "captureStream", {
+      configurable: true,
+      value: vi.fn(function (this: HTMLCanvasElement) {
+        const capture = { canvas: this, track: { readyState: "live" } };
+        hostHarness.captureStreams.push(capture);
+        hostHarness.activeCapture = capture;
+        return { getVideoTracks: () => [capture.track] };
+      }),
+    });
+
+    vi.stubGlobal("requestAnimationFrame", (callback: FrameRequestCallback) => {
+      const id = hostHarness.nextFrameId++;
+      hostHarness.frameCallbacks.set(id, callback);
+      return id;
+    });
+    vi.stubGlobal("cancelAnimationFrame", (id: number) => {
+      hostHarness.frameCallbacks.delete(id);
+    });
+    originalVisibilityState = Object.getOwnPropertyDescriptor(document, "visibilityState");
+    Object.defineProperty(document, "visibilityState", {
+      configurable: true,
+      value: "visible",
+    });
+
+    container = document.createElement("div");
+    document.body.appendChild(container);
+    root = createRoot(container);
+  });
+
+  afterEach(async () => {
+    await act(async () => root.unmount());
+    container.remove();
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+    Object.defineProperty(HTMLCanvasElement.prototype, "getContext", {
+      configurable: true,
+      value: originalGetContext,
+    });
+    if (originalCaptureStream) {
+      Object.defineProperty(HTMLCanvasElement.prototype, "captureStream", originalCaptureStream);
+    } else {
+      Reflect.deleteProperty(HTMLCanvasElement.prototype, "captureStream");
+    }
+    if (originalVisibilityState) {
+      Object.defineProperty(document, "visibilityState", originalVisibilityState);
+    } else {
+      Reflect.deleteProperty(document, "visibilityState");
+    }
+  });
+
+  it("keeps the active capture canvas and live track drawing after switching from Folia", async () => {
+    await act(async () => root.render(React.createElement(VisualizationView)));
+
+    const captureCanvas = container.querySelector<HTMLCanvasElement>(
+      "canvas[data-folia-capture-canvas]"
+    );
+    expect(captureCanvas).not.toBeNull();
+    const openRecording = container.querySelector<HTMLButtonElement>(
+      '[data-testid="open-recording"]'
+    );
+    expect(openRecording).not.toBeNull();
+
+    await act(async () => openRecording?.click());
+    expect(hostHarness.captureStreams).toHaveLength(1);
+    const capture = hostHarness.captureStreams[0];
+    expect(capture.canvas).toBe(captureCanvas);
+    const foliaDrawCount = hostHarness.draws.filter((canvas) => canvas === captureCanvas).length;
+    expect(foliaDrawCount).toBeGreaterThan(0);
+
+    hostHarness.visualization.currentEffect = "cinematicOrientalInk";
+    await act(async () => root.render(React.createElement(VisualizationView)));
+
+    const activeFrame = [...hostHarness.frameCallbacks.entries()][0];
+    expect(activeFrame).toBeDefined();
+    await act(async () => {
+      if (!activeFrame) return;
+      hostHarness.frameCallbacks.delete(activeFrame[0]);
+      activeFrame[1](1000);
+    });
+
+    expect(hostHarness.captureStreams).toHaveLength(1);
+    expect(hostHarness.activeCapture?.canvas).toBe(captureCanvas);
+    expect(hostHarness.activeCapture?.track.readyState).toBe("live");
+    expect(hostHarness.draws.filter((canvas) => canvas === captureCanvas).length).toBeGreaterThan(
+      foliaDrawCount
+    );
+  });
+});
