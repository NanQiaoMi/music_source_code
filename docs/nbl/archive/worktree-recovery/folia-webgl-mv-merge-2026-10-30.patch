+function visibleTexts(root: unknown): string[] {
+  const result: string[] = [];
+  const visit = (node: FakeContainer, ancestorsVisible: boolean) => {
+    if (!ancestorsVisible || !node.visible) return;
+    if (node instanceof FakeText) {
+      if (node.text.trim()) result.push(node.text);
+      return;
+    }
+    node.children.forEach((child) => visit(child, true));
+  };
+  visit(root as FakeContainer, true);
+  return result;
+}
