+          lyrics.update(lastFrame);
+          applyCameraTransform(lyrics.view, lastFrame, buildFoliaMvSceneModel(lastFrame));
+        }
+      },
+      update(frame) {
+        if (destroyed || contextLost) return;
+        lastFrame = frame;
+        scene?.update(frame);
+        lyrics?.update(frame);
+        const camera = buildFoliaMvSceneModel(frame);
+        if (scene) applyCameraTransform(scene.view, frame, camera);
+        if (lyrics) applyCameraTransform(lyrics.view, frame, camera);
+        if (scene?.foregroundView) {
+          applyCameraTransform(scene.foregroundView, frame, camera, true);
+        }
+        application.render();
+      },
+      destroy() {
+        if (destroyed) return;
+        destroyed = true;
+        application.canvas.removeEventListener("webglcontextlost", handleContextLost);
+        application.canvas.removeEventListener("webglcontextrestored", handleContextRestored);
+        if (lyrics) {
+          application.stage.removeChild(lyrics.view);
+          lyrics.destroy();
+          lyrics = null;
+        }
+        if (scene) {
+          application.stage.removeChild(scene.view);
+          if (scene.foregroundView) application.stage.removeChild(scene.foregroundView);
+          scene.destroy();
+          scene = null;
+        }
+        if (application.canvas.parentElement === host) host.removeChild(application.canvas);
+        application.destroy(true, { children: true, texture: true, textureSource: true });
+      },
+    };
+
+    return runtime;
+  } catch (error) {
+    scene?.destroy();
+    lyrics?.destroy();
+    if (initialized) {
+      application.destroy(true, { children: true, texture: true, textureSource: true });
+    } else {
+      // Pixi can throw while probing a missing WebGL context before its renderer
+      // exists. A best-effort destroy releases any partial initialization state.
+      try {
+        application.destroy(true, { children: true, texture: true, textureSource: true });
+      } catch {
+        // The caller selects the readable DOM fallback when initialization fails.
+      }
+    }
+    throw error;
+  }
+}
+
+function clampResolution(value: number): number {
+  return Number.isFinite(value) ? Math.max(1, Math.min(2, value)) : 1;
+}
+
+function applyCameraTransform(
+  view: FoliaMvLayer["view"],
+  frame: FoliaMvFrame,
+  camera: ReturnType<typeof buildFoliaMvSceneModel>,
+  keepLocalOffset = false
+): void {
+  const transform = view as unknown as {
+    pivot?: { set(x: number, y: number): void };
+    position?: { x: number; y: number; set(x: number, y: number): void };
+    scale?: { set(x: number, y: number): void };
+  };
+  if (!transform.pivot?.set || !transform.position?.set || !transform.scale?.set) return;
+
+  const offsetX = keepLocalOffset ? transform.position.x : 0;
+  const offsetY = keepLocalOffset ? transform.position.y : 0;
+  const centerX = frame.width / 2;
+  const centerY = frame.height / 2;
+  transform.pivot.set(centerX, centerY);
+  transform.position.set(centerX + camera.cameraX + offsetX, centerY + camera.cameraY + offsetY);
+  transform.scale.set(camera.cameraScale, camera.cameraScale);
+}
