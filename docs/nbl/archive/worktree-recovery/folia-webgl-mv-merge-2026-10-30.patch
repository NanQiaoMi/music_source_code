+
+const OPENING_CREDIT_SECONDS = 3;
+
+interface FoliaFallbackContent {
+  lines: FoliaMvLine[];
+  credit: "opening" | "outro" | null;
+  creditPhase?: "title" | "artist" | null;
+}
+
+interface FoliaFallbackFrame {
+  width: number;
+  height: number;
+  resolution: number;
+  musicTime: number;
+  ambientTime: number;
+  reducedMotion: boolean;
+  program: FoliaMvProgram;
+  settings: ReturnType<typeof normalizeFoliaMvSettings>;
+  palette: FoliaMvPalette;
+}
+
+/** Only timed lyric windows become lyric text in the accessible or Canvas fallback layer. */
+function selectFallbackContent(program: FoliaMvProgram, time: number): FoliaFallbackContent {
+  const boundedTime = Number.isFinite(time) ? clamp(time, 0, program.duration) : 0;
+  const shot = findFoliaMvShot(program, boundedTime);
+  const lines =
+    shot?.kind === "lyrics"
+      ? getShotLines(program, shot).filter(
+          (line) =>
+            boundedTime >= line.start &&
+            boundedTime <= line.end + FOLIA_MV_LINE_EXIT_SECONDS &&
+            resolveFoliaMvLineTailOpacity(boundedTime, line.end) > 0
+        )
+      : [];
+  if (lines.length > 0 || program.lines.length === 0) return { lines, credit: null };
+
+  if (!shot) return { lines: [], credit: null };
+
+  const firstLine = program.lines[0]!;
+  if (
+    shot.kind === "intro" &&
+    boundedTime < firstLine.start &&
+    boundedTime <= Math.min(OPENING_CREDIT_SECONDS, firstLine.start)
+  ) {
+    return { lines: [], credit: "opening" };
+  }
+  if (shot.kind === "outro") {
+    return {
+      lines: [],
+      credit: "outro",
+      creditPhase: resolveFoliaMvOutroCreditPhase(shot, boundedTime),
+    };
+  }
+  return { lines: [], credit: null };
+}
+
+function getShotLines(program: FoliaMvProgram, shot: FoliaMvFrame["shot"]): FoliaMvLine[] {
+  if (shot?.kind !== "lyrics") return [];
+  if (shot.lineIndices.length === 0) return [...program.lines];
+  return shot.lineIndices.flatMap((lineIndex) => {
+    const line = program.lines[lineIndex];
+    return line ? [line] : [];
+  });
+}
+
+/** Draw a complete, recordable Canvas2D scene during loading, WebGL failure, or context loss. */
