+  const drift = Math.sin(time * 0.12) * Math.min(width, height) * 0.012;
+
+  context.save();
+  context.setTransform(resolution, 0, 0, resolution, 0, 0);
+  context.clearRect(0, 0, width, height);
+  context.fillStyle = colorCss(palette.background);
+  context.fillRect(0, 0, width, height);
+
+  const warmGlow = context.createRadialGradient(
+    width * 0.2 + drift,
+    height * 0.78,
+    0,
+    width * 0.2,
+    height * 0.78,
+    Math.max(width, height) * 0.62
+  );
+  warmGlow.addColorStop(0, rgbaCss(palette.accent, 0.12 + pulse * 0.025));
+  warmGlow.addColorStop(1, rgbaCss(palette.accent, 0));
+  context.fillStyle = warmGlow;
+  context.fillRect(0, 0, width, height);
+
+  const coolGlow = context.createRadialGradient(
+    width * 0.79,
+    height * 0.18 - drift,
+    0,
+    width * 0.79,
+    height * 0.18,
+    Math.max(width, height) * 0.54
+  );
+  coolGlow.addColorStop(0, "rgba(80, 132, 166, 0.12)");
+  coolGlow.addColorStop(1, "rgba(80, 132, 166, 0)");
+  context.fillStyle = coolGlow;
+  context.fillRect(0, 0, width, height);
+
+  const centerGlow = context.createRadialGradient(
+    width * 0.52,
+    height * 0.48,
+    0,
+    width * 0.52,
+    height * 0.48,
+    Math.max(width, height) * 0.5
+  );
+  centerGlow.addColorStop(0, "rgba(25, 35, 48, 0.35)");
+  centerGlow.addColorStop(1, "rgba(2, 4, 8, 0.9)");
+  context.fillStyle = centerGlow;
+  context.fillRect(0, 0, width, height);
+
+  const orbitX = width * 0.2 + drift;
+  const orbitY = height * 0.37;
+  context.beginPath();
+  context.ellipse(orbitX, orbitY, width * 0.23, height * 0.27, -0.24, 0, Math.PI * 2);
+  context.ellipse(orbitX, orbitY, width * 0.17, height * 0.2, 0.18, 0, Math.PI * 2);
+  context.strokeStyle = "rgba(215, 228, 237, 0.065)";
+  context.lineWidth = Math.max(0.7, width / 2400);
+  context.stroke();
+
+  for (let index = 0; index < 22; index += 1) {
+    const x = ((index * 197.3 + width * 0.11) % width) + Math.sin(time * 0.13 + index) * 8;
+    const y =
+      ((index * 113.7 + height * 0.07) % height) - ((time * (2 + (index % 3)) * 4) % height);
+    context.beginPath();
+    context.arc(x, (y + height) % height, index % 7 === 0 ? 1.3 : 0.75, 0, Math.PI * 2);
+    context.fillStyle = `rgba(222, 232, 239, ${0.08 + ((index * 17) % 7) * 0.012})`;
+    context.fill();
+  }
+
+  const vignette = context.createRadialGradient(
+    width * 0.5,
+    height * 0.48,
+    Math.min(width, height) * 0.16,
+    width * 0.5,
+    height * 0.48,
+    Math.max(width, height) * 0.73
+  );
+  vignette.addColorStop(0, "rgba(0, 0, 0, 0)");
+  vignette.addColorStop(1, "rgba(0, 0, 0, 0.58)");
+  context.fillStyle = vignette;
+  context.fillRect(0, 0, width, height);
+
+  const content = selectFallbackContent(program, musicTime);
+  if (content.lines.length > 0) {
+    drawFallbackLyrics(context, content.lines, musicTime, width, height, settings, palette);
+  } else if (content.credit) {
+    drawFallbackCredit(
+      context,
+      content.credit,
+      content.creditPhase ?? null,
+      program,
+      width,
+      height,
+      palette
+    );
+  }
+  context.restore();
+}
+
+function drawFallbackLyrics(
+  context: CanvasRenderingContext2D,
+  lines: readonly FoliaMvLine[],
+  musicTime: number,
+  width: number,
+  height: number,
+  settings: ReturnType<typeof normalizeFoliaMvSettings>,
+  palette: FoliaMvPalette
+): void {
+  const fontFamilies = [
+    "Georgia, 'Songti SC', 'Noto Serif CJK SC', serif",
+    "'Songti SC', 'Noto Serif CJK SC', Georgia, serif",
+    "'STSong', 'Songti SC', serif",
+    "'Avenir Next', 'Microsoft YaHei', sans-serif",
+  ];
+  const fontFamily = fontFamilies[Math.round(settings.fontStyle)] ?? fontFamilies[0];
+  const fontSize = Math.max(26, Math.min(height * 0.09, settings.heroFontSize * 1.55, 100));
+  const lineHeight = fontSize * 1.4;
+  const centerY = height * 0.49 - ((Math.min(lines.length, 2) - 1) * lineHeight) / 2;
+
+  lines.slice(0, 2).forEach((line, index) => {
+    const tailOpacity = resolveFoliaMvLineTailOpacity(musicTime, line.end);
+    let size = fontSize;
+    context.font = `600 ${size}px ${fontFamily}`;
+    const maxWidth = width * 0.82;
+    const measuredWidth = context.measureText(line.text).width;
+    if (measuredWidth > maxWidth && measuredWidth > 0) {
+      size = Math.max(22, size * (maxWidth / measuredWidth));
+      context.font = `600 ${size}px ${fontFamily}`;
+    }
+    const textWidth = Math.min(maxWidth, context.measureText(line.text).width);
+    const x = width * 0.5 + (index - (Math.min(lines.length, 2) - 1) / 2) * width * 0.035;
+    const y = centerY + index * lineHeight;
+    const progress = clamp((musicTime - line.start) / Math.max(0.08, line.end - line.start), 0, 1);
+
+    context.save();
+    context.globalAlpha = tailOpacity;
+    context.textAlign = "center";
+    context.textBaseline = "middle";
+    context.shadowBlur = 0;
+    context.fillStyle = "rgba(194, 198, 205, 0.35)";
+    context.fillText(line.text, x, y, maxWidth);
+    context.beginPath();
+    context.rect(
+      x - textWidth / 2,
+      y - size * 0.72,
+      Math.max(1, textWidth * progress),
+      size * 1.45
+    );
+    context.clip();
+    context.shadowColor = rgbaCss(palette.accent, 0.48);
+    context.shadowBlur = Math.min(32, size * 0.38);
+    context.fillStyle = colorCss(palette.ink);
+    context.fillText(line.text, x, y, maxWidth);
+    context.restore();
+
+    if (line.translation) {
+      context.save();
+      context.globalAlpha = tailOpacity;
+      context.font = `400 ${Math.max(14, size * 0.23)}px 'Avenir Next', 'Microsoft YaHei', sans-serif`;
+      context.textAlign = "center";
+      context.textBaseline = "top";
+      context.fillStyle = rgbaCss(palette.muted, 0.82);
+      context.fillText(line.translation, x, y + size * 0.78, maxWidth);
+      context.restore();
+    }
+  });
+}
+
+function drawFallbackCredit(
+  context: CanvasRenderingContext2D,
+  credit: "opening" | "outro",
+  creditPhase: "title" | "artist" | null,
+  program: FoliaMvProgram,
+  width: number,
+  height: number,
+  palette: FoliaMvPalette
+): void {
+  context.save();
+  context.textAlign = "center";
+  context.textBaseline = "middle";
+  context.shadowColor = rgbaCss(palette.accent, 0.28);
+  context.shadowBlur = 24;
+  context.font = `500 ${Math.max(22, Math.min(height * 0.052, 58))}px Georgia, 'Songti SC', serif`;
+  const showTitle = credit === "opening" || creditPhase === "title";
+  const showArtist = credit === "opening" || creditPhase === "artist";
+  context.fillStyle = rgbaCss(palette.ink, credit === "opening" ? 0.7 : 0.92);
+  if (showTitle && program.title) {
+    context.fillText(program.title, width * 0.5, height * 0.46, width * 0.8);
+  }
+
+  if (showArtist && program.artist) {
+    context.shadowBlur = 0;
+    context.font = `400 ${Math.max(12, Math.min(height * 0.018, 18))}px 'Avenir Next', 'Microsoft YaHei', sans-serif`;
+    context.fillStyle = rgbaCss(palette.muted, credit === "opening" ? 0.66 : 0.84);
+    context.fillText(
+      program.artist,
+      width * 0.5,
+      height * (credit === "opening" ? 0.53 : 0.5),
+      width * 0.8
+    );
+  }
+  context.restore();
+}
+
+function rgbaCss(color: number, alpha: number): string {
+  const value = Math.max(0, Math.min(0xffffff, Math.round(color)));
+  return `rgba(${(value >> 16) & 0xff}, ${(value >> 8) & 0xff}, ${value & 0xff}, ${clamp(alpha, 0, 1)})`;
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.max(min, Math.min(max, Number.isFinite(value) ? value : min));
+}
+
+function readAudioBands(data: Uint8Array): Pick<FoliaMvFrame, "bass" | "mid" | "treble"> {
+  const average = (start: number, end: number) => {
+    if (end <= start) return 0;
+    let sum = 0;
+    for (let index = start; index < end; index += 1) sum += data[index] ?? 0;
+    return sum / (end - start) / 255;
+  };
+  return {
+    bass: average(1, Math.min(9, data.length)),
+    mid: average(9, Math.min(32, data.length)),
+    treble: average(32, data.length),
+  };
+}
+
+function colorCss(color: number): string {
+  return `#${Math.max(0, Math.min(0xffffff, Math.round(color)))
+    .toString(16)
+    .padStart(6, "0")}`;
+}
+
+function formatTime(value: number): string {
+  const safe = Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
+  return `${Math.floor(safe / 60)}:${String(safe % 60).padStart(2, "0")}`;
+}
