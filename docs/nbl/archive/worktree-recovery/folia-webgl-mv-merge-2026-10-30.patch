+
+function installCanvasContext() {
+  const gradient = { addColorStop: vi.fn() };
+  const context = {
+    canvas: document.createElement("canvas"),
+    clearRect: vi.fn(),
+    drawImage: vi.fn(),
+    fillRect: vi.fn(),
+    fillText: vi.fn(),
+    measureText: vi.fn(() => ({ width: 240 })),
+    createRadialGradient: vi.fn(() => gradient),
+    createLinearGradient: vi.fn(() => gradient),
+    setTransform: vi.fn(),
+    save: vi.fn(),
+    restore: vi.fn(),
+    beginPath: vi.fn(),
+    ellipse: vi.fn(),
+    arc: vi.fn(),
+    moveTo: vi.fn(),
+    lineTo: vi.fn(),
+    rect: vi.fn(),
+    clip: vi.fn(),
+    stroke: vi.fn(),
+    fill: vi.fn(),
+  } as unknown as CanvasRenderingContext2D;
+  vi.spyOn(HTMLCanvasElement.prototype, "getContext").mockImplementation(function (
+    this: HTMLCanvasElement,
+    contextId: string
+  ) {
+    requestedCanvases.push(this);
+    if (contextId === "2d") return context;
+    return null;
+  } as HTMLCanvasElement["getContext"]);
+  return context;
+}
