+    let destroyed = false;
+    let contextLost = false;
+    const handleContextLost = (event: Event) => {
+      event.preventDefault();
+      contextLost = true;
+      onContextState?.(true);
+    };
+    const handleContextRestored = () => {
+      contextLost = false;
+      onContextState?.(false);
+      application.render();
+    };
+    application.canvas.addEventListener("webglcontextlost", handleContextLost);
+    application.canvas.addEventListener("webglcontextrestored", handleContextRestored);
+
+    const runtime: FoliaMvRuntime = {
+      canvas: application.canvas,
+      resize(nextWidth, nextHeight, nextResolution) {
+        if (destroyed) return;
+        const safeWidth = Math.max(1, Math.round(nextWidth));
+        const safeHeight = Math.max(1, Math.round(nextHeight));
+        activeWidth = safeWidth;
+        activeHeight = safeHeight;
+        application.renderer.resize(safeWidth, safeHeight, clampResolution(nextResolution));
+        scene?.resize(safeWidth, safeHeight);
+        lyrics?.resize(safeWidth, safeHeight);
+      },
+      setProgram(nextProgram) {
+        if (destroyed || activeProgram === nextProgram) return;
+        const previousLayer = lyrics;
+        if (scene?.foregroundView) application.stage.removeChild(scene.foregroundView);
+        if (previousLayer) {
